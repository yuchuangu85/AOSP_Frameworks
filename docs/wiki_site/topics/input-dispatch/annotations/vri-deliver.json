      "text": "异步 trace 段（跨线程可辨），用于在 Perfetto 里对齐事件 id。"
    },
    {
      "at": 3,
      "quote": "q.mEvent.getId());",
      "kind": "note",
      "text": "同一 id 在 finishInputEvent 时配对。"
    },
    {
      "at": 4,
      "quote": "",
      "kind": "note",
      "text": "空行。"
    },
    {
      "at": 5,
      "quote": "if (Trace.isTagEnabled(Trace.TRACE_TAG_VIEW)) {",
