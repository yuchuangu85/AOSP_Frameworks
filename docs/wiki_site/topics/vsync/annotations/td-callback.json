{
  "id": "td-callback",
  "title": "VSyncDispatchTimerQueue::timerCallback",
  "file": "native/services/surfaceflinger/Scheduler/VSyncDispatchTimerQueue.cpp",
  "sig": "void VSyncDispatchTimerQueue::timerCallback() {",
  "span": [
