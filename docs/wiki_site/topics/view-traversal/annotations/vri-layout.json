  "notes": [
    {
      "at": 1,
      "quote": "private void performLayout(WindowManager.LayoutParams lp, int desiredWindowWidth,",
      "kind": "note",
      "text": "布局入口。lp 与 desiredWindow* 只服务于「二次布局时重新 measure」这一路。"
    },
    {
      "at": 2,
      "quote": "int desiredWindowHeight) {",
      "kind": "note",
      "text": "第二行参数收尾。"
    },
    {
