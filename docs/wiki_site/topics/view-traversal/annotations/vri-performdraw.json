  "notes": [
    {
      "at": 1,
      "quote": "private boolean performDraw(@Nullable SurfaceSyncGroup surfaceSyncGroup) {",
      "kind": "note",
      "text": "绘制总控。返回 false 表示「这一帧没画」；surfaceSyncGroup 非空时会要求全量重画并对齐事务。"
    },
    {
      "at": 2,
      "quote": "mLastPerformDrawSkippedReason = null;",
      "kind": "state",
      "text": "先清上次的跳过原因，便于 dumpsys/trace 里区分「本帧正常」与「上帧被跳过」。"
    },
    {
      "at": 3,
      "quote": "if (mAttachInfo.mDisplayState == Display.STATE_OFF && !mReportNextDraw) {",
      "kind": "branch",
      "text": "屏幕关且没人要求 report：直接不画。这是「黑屏时不做无用功」的第一道闸门。"
    },
    {
      "at": 4,
      "quote": "mLastPerformDrawSkippedReason = \"screen_off\";",
      "kind": "data",
      "text": "记录跳过原因字符串，后面会进 dumpsys gfxinfo 一类输出。"
    },
    {
      "at": 5,
      "quote": "if (!mLastDrawScreenOff) {",
      "kind": "branch",
      "text": "只在「状态翻转」时打日志，避免每帧刷屏。"
    },
    {
      "at": 6,
      "quote": "logAndTrace(\"Not drawing due to screen off\");",
      "kind": "trace",
      "text": "trace 与 log 同时打点，Perfetto 里能直接看到这一帧为什么没有 draw 切片。"
    },
    {
      "at": 7,
      "quote": "}",
      "kind": "note",
      "text": "关闭状态翻转判断。"
    },
    {
      "at": 8,
      "quote": "mLastDrawScreenOff = true;",
      "kind": "state",
      "text": "记住「已经因息屏停画」，供下次亮屏时打恢复日志。"
    },
    {
      "at": 9,
      "quote": "return false;",
      "kind": "note",
      "text": "本帧不画，performTraversals 看到 false 会走「没有异步绘制」的收尾分支。"
    },
    {
      "at": 10,
      "quote": "} else if (mView == null) {",
      "kind": "branch",
      "text": "第二道闸门：根 View 已 detach。"
    },
    {
      "at": 11,
      "quote": "mLastPerformDrawSkippedReason = \"no_root_view\";",
      "kind": "data",
      "text": "同样记录原因。"
    },
    {
