      "quote": "return false;",
      "kind": "note",
      "text": "没有根就没有树，什么也不画。"
    },
    {
      "at": 13,
      "quote": "}",
      "kind": "note",
      "text": "关闭闸门判断。"
    },
    {
      "at": 15,
      "quote": "if (mLastDrawScreenOff) {",
