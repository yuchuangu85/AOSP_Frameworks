  ],
  "notes": [
    {
      "at": 1,
      "quote": "status_t BBinder::transact(",
      "kind": "note",
      "text": "本地实体侧入口。注意它**先处理一批内置 code**（PING/EXTENSION 等），只有其它 code 才落到 onTransact。"
    },
    {
      "at": 2,
      "quote": "uint32_t code, const Parcel& data, Parcel* reply, uint32_t flags)",
      "kind": "note",
      "text": "续行参数。"
    },
    {
      "at": 3,
      "quote": "{",
      "kind": "note",
      "text": "函数开始。"
    },
    {
      "at": 4,
      "quote": "bool tracingEnabled = get_trace_enabled_tags() & ATRACE_TAG_AIDL;",
      "kind": "data",
      "text": "是否开了 AIDL trace。"
    },
    {
      "at": 5,
      "quote": "if (tracingEnabled) {",
      "kind": "branch",
      "text": "开了 trace。"
    },
    {
      "at": 6,
      "quote": "tracingEnabled = startTrace(code);",
      "kind": "call",
      "text": "开始一个以 code 命名的切片。"
    },
    {
      "at": 7,
      "quote": "}",
      "kind": "note",
      "text": "关闭判断。"
    },
    {
      "at": 8,
      "quote": "",
      "kind": "note",
      "text": "空行。"
    },
    {
      "at": 9,
      "quote": "scope_guard guard = make_scope_guard([&]() {",
      "kind": "data",
      "text": "**scope_guard 保证 trace 一定闭合**，即使 onTransact 抛异常。"
    },
    {
      "at": 10,
      "quote": "if (tracingEnabled) trace_end(ATRACE_TAG_AIDL);",
      "kind": "note",
      "text": "续行。"
    },
    {
      "at": 11,
      "quote": "});",
      "kind": "note",
      "text": "结束切片。"
    },
    {
      "at": 12,
      "quote": "",
      "kind": "note",
      "text": "闭合 lambda。"
    },
    {
      "at": 13,
      "quote": "const auto startTime = std::chrono::steady_clock::now();",
      "kind": "note",
      "text": "空行。"
