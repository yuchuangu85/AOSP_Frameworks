    },
    {
      "at": 18,
      "quote": "reply->markSensitive();",
      "kind": "branch",
      "text": "带 FLAG_CLEAR_BUF 且要回包。"
    },
    {
      "at": 19,
      "quote": "}",
      "kind": "call",
      "text": "标记回包为敏感（可被清零）。"
