      "text": "断言有 reply。"
    },
    {
      "at": 46,
      "quote": "break;",
      "kind": "call",
      "text": "写 pid。"
    },
    {
      "at": 47,
      "quote": "case SET_RPC_CLIENT_TRANSACTION: {",
      "kind": "note",
      "text": "跳出。"
    },
    {
      "at": 48,
      "quote": "err = setRpcClientDebug(data);",
      "kind": "branch",
      "text": "设置 RPC client。"
    },
    {
