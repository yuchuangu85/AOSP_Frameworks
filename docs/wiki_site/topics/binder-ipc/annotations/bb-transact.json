      "quote": "reply ? *reply : emptyReply, err);",
      "kind": "note",
      "text": "续行。"
    },
    {
      "at": 78,
      "quote": "if (transaction) {",
      "kind": "branch",
      "text": "构造成功。"
    },
    {
      "at": 79,
