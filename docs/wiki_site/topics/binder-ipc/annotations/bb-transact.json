    },
    {
      "at": 70,
      "quote": "RpcMutexUniqueLock lock(e->mLock);",
      "kind": "lock",
      "text": "取记录锁。"
    },
    {
      "at": 71,
      "quote": "if (e->mRecordingOn) {",
      "kind": "branch",
      "text": "双重检查仍在记录。"
