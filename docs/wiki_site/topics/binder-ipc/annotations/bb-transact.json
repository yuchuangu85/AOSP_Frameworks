      "text": "跳出。"
    },
    {
      "at": 44,
      "quote": "LOG_ALWAYS_FATAL_IF(reply == nullptr, \"reply == nullptr\");",
      "kind": "branch",
      "text": "取 debug pid。"
    },
    {
      "at": 45,
      "quote": "err = reply->writeInt32(getDebugPid());",
