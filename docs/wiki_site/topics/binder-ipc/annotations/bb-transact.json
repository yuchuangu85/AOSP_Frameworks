      "quote": "break;",
      "kind": "call",
      "text": "转发。"
    },
    {
      "at": 50,
      "quote": "}",
      "kind": "note",
      "text": "跳出。"
    },
    {
      "at": 51,
      "quote": "default:",
      "kind": "note",
      "text": "**默认分支才是业务**。"
    },
    {
