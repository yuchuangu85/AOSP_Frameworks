    {
      "at": 31,
      "quote": "err = pingBinder();",
      "kind": "branch",
      "text": "PING：探活。"
    },
    {
      "at": 32,
      "quote": "break;",
      "kind": "call",
      "text": "调 pingBinder。"
    },
    {
      "at": 33,
      "quote": "case START_RECORDING_TRANSACTION:",
      "kind": "note",
      "text": "跳出。"
    },
    {
      "at": 34,
      "quote": "err = startRecordingTransactions(data);",
      "kind": "branch",
      "text": "开始记录事务。"
    },
    {
      "at": 35,
      "quote": "break;",
      "kind": "call",
      "text": "无参版本（这里传 data 只是兼容签名）。"
