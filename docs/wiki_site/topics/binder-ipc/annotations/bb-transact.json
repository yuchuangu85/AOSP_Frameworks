    {
      "at": 20,
      "quote": "",
      "kind": "note",
      "text": "关闭判断。"
    },
    {
      "at": 21,
      "quote": "if (data.dataSize() > binder::kLogTransactionsOverBytes) {",
      "kind": "note",
      "text": "空行。"
    },
    {
