    {
      "at": 24,
      "quote": "data.dataSize(), String8(getInterfaceDescriptor()).c_str(),",
      "kind": "note",
      "text": "续行。"
    },
    {
      "at": 25,
      "quote": "getFunctionNameAndCode(code).c_str(), flags);",
      "kind": "note",
      "text": "续行。"
