  "notes": [
    {
      "at": 1,
      "quote": "static jboolean android_os_BinderProxy_transact(JNIEnv* env, jobject obj,",
      "kind": "note",
      "text": "Java 与 native 的接缝。它几乎把「Java 语义」翻译成「native 语义」的全部工作集中在一处。"
    },
    {
      "at": 2,
      "quote": "jint code, jobject dataObj, jobject replyObj, jint flags) // throws RemoteException",
      "kind": "note",
      "text": "续行：code/data/reply/flags，注释标明可能抛 RemoteException。"
    },
    {
      "at": 3,
      "quote": "{",
      "kind": "note",
      "text": "函数开始。"
    },
    {
      "at": 4,
      "quote": "if (dataObj == NULL) {",
      "kind": "branch",
      "text": "data 为空。"
    },
    {
      "at": 5,
      "quote": "jniThrowNullPointerException(env, NULL);",
      "kind": "call",
      "text": "抛 NPE（与 Java 侧契约一致）。"
    },
    {
      "at": 6,
      "quote": "return JNI_FALSE;",
      "kind": "note",
      "text": "返回 false。"
    },
    {
      "at": 7,
      "quote": "}",
      "kind": "note",
      "text": "关闭判断。"
    },
    {
      "at": 8,
      "quote": "",
      "kind": "note",
      "text": "空行。"
    },
    {
      "at": 9,
      "quote": "Parcel* data = parcelForJavaObject(env, dataObj);",
      "kind": "call",
      "text": "**Java Parcel → native Parcel**：本质是取 Java 对象里保存的 native 指针。"
    },
    {
      "at": 10,
      "quote": "if (data == NULL) {",
      "kind": "branch",
      "text": "转换失败。"
    },
    {
