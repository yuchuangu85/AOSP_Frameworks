      "kind": "note",
      "text": "返回 false。"
    },
    {
      "at": 16,
      "quote": "}",
      "kind": "note",
      "text": "关闭判断。"
    },
    {
      "at": 17,
      "quote": "",
      "kind": "note",
      "text": "空行。"
    },
    {
      "at": 18,
      "quote": "IBinder* target = getBPNativeData(env, obj)->mObject.get();",
