      "quote": "mListenerCallbacks[listener].callbackIds.insert(std::make_move_iterator(",
      "kind": "call",
      "text": "把 other 的 callbackIds move 进来。"
    },
    {
      "at": 5,
      "quote": "callbackIds.begin()),",
      "kind": "note",
      "text": "续行。"
    },
    {
      "at": 6,
      "quote": "std::make_move_iterator(callbackIds.end()));",
      "kind": "note",
      "text": "闭合。"
