      "text": "把绑定的 SurfaceControl 也并进来。"
    },
    {
      "at": 9,
      "quote": "surfaceControls.end());",
      "kind": "note",
      "text": "续行。"
    },
    {
      "at": 10,
      "quote": "",
      "kind": "note",
      "text": "空行。"
    },
    {
      "at": 11,
      "quote": "auto& currentProcessCallbackInfo =",
      "kind": "data",
      "text": "本进程自身的 TransactionCompletedListener 也要记录这些 SurfaceControl。"
    },
    {
      "at": 12,
      "quote": "mListenerCallbacks[TransactionCompletedListener::getIInstance()];",
      "kind": "note",
      "text": "续行。"
    },
    {
      "at": 13,
